{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "failure-log.schema.json",
  "title": "Code Review Failure Log",
  "description": "Schema for tracking code review violations, enabling trend analysis and continuous improvement of prompts and documentation",
  "type": "object",
  "required": ["metadata", "rule_statistics", "reviews"],
  "properties": {
    "metadata": {
      "type": "object",
      "description": "Log metadata and configuration",
      "required": ["version", "created_at", "last_updated"],
      "properties": {
        "version": {
          "type": "string",
          "description": "Schema version for migrations",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "When this log was created"
        },
        "last_updated": {
          "type": "string",
          "format": "date-time",
          "description": "Last modification timestamp"
        },
        "total_reviews": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of reviews logged"
        },
        "total_violations": {
          "type": "integer",
          "minimum": 0,
          "description": "Total violations across all reviews"
        }
      }
    },
    "rule_statistics": {
      "type": "object",
      "description": "Aggregated statistics per rule for trend analysis",
      "additionalProperties": {
        "$ref": "#/definitions/RuleStatistics"
      }
    },
    "domain_statistics": {
      "type": "object",
      "description": "Aggregated statistics per domain",
      "additionalProperties": {
        "$ref": "#/definitions/DomainStatistics"
      }
    },
    "agent_statistics": {
      "type": "object",
      "description": "Statistics per coding agent (if tracked)",
      "additionalProperties": {
        "$ref": "#/definitions/AgentStatistics"
      }
    },
    "reviews": {
      "type": "array",
      "description": "Individual review entries",
      "items": {
        "$ref": "#/definitions/ReviewEntry"
      }
    }
  },
  "definitions": {
    "RuleStatistics": {
      "type": "object",
      "description": "Statistics for a single rule",
      "required": ["rule_id", "domain", "total_occurrences"],
      "properties": {
        "rule_id": {
          "type": "string",
          "description": "Unique rule identifier (e.g., C001, S002)",
          "pattern": "^[A-Z]+\\d{3}$"
        },
        "rule_name": {
          "type": "string",
          "description": "Human-readable rule name"
        },
        "domain": {
          "type": "string",
          "enum": [
            "client",
            "server",
            "components",
            "routes",
            "integrations",
            "types"
          ],
          "description": "Domain this rule belongs to"
        },
        "severity": {
          "type": "string",
          "enum": ["error", "warning", "suggestion"],
          "description": "Default severity level"
        },
        "total_occurrences": {
          "type": "integer",
          "minimum": 0,
          "description": "All-time occurrence count"
        },
        "last_7_days": {
          "type": "integer",
          "minimum": 0,
          "description": "Occurrences in last 7 days"
        },
        "last_30_days": {
          "type": "integer",
          "minimum": 0,
          "description": "Occurrences in last 30 days"
        },
        "trend": {
          "type": "string",
          "enum": ["increasing", "stable", "decreasing"],
          "description": "Trend direction based on recent data"
        },
        "first_seen": {
          "type": "string",
          "format": "date-time",
          "description": "When this rule was first violated"
        },
        "last_seen": {
          "type": "string",
          "format": "date-time",
          "description": "Most recent violation"
        },
        "common_files": {
          "type": "array",
          "description": "Files where this violation commonly occurs",
          "items": {
            "type": "string"
          },
          "maxItems": 10
        },
        "common_contexts": {
          "type": "array",
          "description": "Task contexts where this violation commonly occurs",
          "items": {
            "type": "string"
          },
          "maxItems": 10
        },
        "documentation_reference": {
          "type": "string",
          "description": "Path to documentation for this rule"
        },
        "improvement_notes": {
          "type": "string",
          "description": "Notes on documentation/prompt improvements made"
        }
      }
    },
    "DomainStatistics": {
      "type": "object",
      "description": "Statistics for a domain",
      "properties": {
        "domain": {
          "type": "string",
          "enum": [
            "client",
            "server",
            "components",
            "routes",
            "integrations",
            "types"
          ]
        },
        "total_violations": {
          "type": "integer",
          "minimum": 0
        },
        "total_errors": {
          "type": "integer",
          "minimum": 0
        },
        "total_warnings": {
          "type": "integer",
          "minimum": 0
        },
        "last_30_days": {
          "type": "integer",
          "minimum": 0
        },
        "most_common_rule": {
          "type": "string",
          "description": "Most frequently violated rule in this domain"
        },
        "trend": {
          "type": "string",
          "enum": ["increasing", "stable", "decreasing"]
        }
      }
    },
    "AgentStatistics": {
      "type": "object",
      "description": "Statistics for a coding agent",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "total_violations": {
          "type": "integer",
          "minimum": 0
        },
        "total_reviews": {
          "type": "integer",
          "minimum": 0
        },
        "approval_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Percentage of PRs approved on first review"
        },
        "common_violations": {
          "type": "array",
          "description": "Rules this agent commonly violates",
          "items": {
            "type": "object",
            "properties": {
              "rule_id": { "type": "string" },
              "count": { "type": "integer" }
            }
          },
          "maxItems": 10
        },
        "last_30_days_violations": {
          "type": "integer",
          "minimum": 0
        },
        "trend": {
          "type": "string",
          "enum": ["improving", "stable", "declining"]
        }
      }
    },
    "ReviewEntry": {
      "type": "object",
      "description": "A single code review entry",
      "required": ["review_id", "timestamp", "outcome", "violations"],
      "properties": {
        "review_id": {
          "type": "string",
          "description": "Unique identifier for this review"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the review was performed"
        },
        "pr_id": {
          "type": "string",
          "description": "Pull request identifier (if applicable)"
        },
        "pr_title": {
          "type": "string",
          "description": "Pull request title"
        },
        "pr_url": {
          "type": "string",
          "format": "uri",
          "description": "URL to the pull request"
        },
        "branch": {
          "type": "string",
          "description": "Branch name being reviewed"
        },
        "agent_id": {
          "type": "string",
          "description": "ID of the coding agent that created the code"
        },
        "task_context": {
          "type": "string",
          "description": "Original task/feature description"
        },
        "domains_affected": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "client",
              "server",
              "components",
              "routes",
              "integrations",
              "types"
            ]
          },
          "description": "Domains touched by this PR"
        },
        "files_changed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of files changed"
        },
        "outcome": {
          "type": "string",
          "enum": ["approved", "rejected", "needs_revision"],
          "description": "Review decision"
        },
        "blocking_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of blocking violations"
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of warnings"
        },
        "suggestion_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of suggestions"
        },
        "violations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Violation"
          },
          "description": "All violations found in this review"
        },
        "manual_findings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Manual verification findings not captured by scripts"
        },
        "evidence_status": {
          "type": "object",
          "properties": {
            "screenshots_provided": { "type": "boolean" },
            "tests_included": { "type": "boolean" },
            "test_output_included": { "type": "boolean" }
          },
          "description": "Evidence verification status"
        },
        "commit_quality": {
          "type": "object",
          "properties": {
            "atomic_commits": { "type": "boolean" },
            "clear_messages": { "type": "boolean" },
            "issues": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "review_duration_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "How long the review took"
        },
        "reviewer_notes": {
          "type": "string",
          "description": "Free-form notes from the reviewer"
        }
      }
    },
    "Violation": {
      "type": "object",
      "description": "A single code violation",
      "required": ["rule_id", "domain", "severity", "file_path", "line_number"],
      "properties": {
        "rule_id": {
          "type": "string",
          "description": "Rule identifier (e.g., C001, S002)",
          "pattern": "^[A-Z]+\\d{3}$"
        },
        "rule_name": {
          "type": "string",
          "description": "Human-readable rule name"
        },
        "domain": {
          "type": "string",
          "enum": [
            "client",
            "server",
            "components",
            "routes",
            "integrations",
            "types"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["error", "warning", "suggestion"]
        },
        "file_path": {
          "type": "string",
          "description": "Path to the file with violation"
        },
        "line_number": {
          "type": "integer",
          "minimum": 1,
          "description": "Line number of violation"
        },
        "column_number": {
          "type": "integer",
          "minimum": 1,
          "description": "Column number (if available)"
        },
        "message": {
          "type": "string",
          "description": "Description of the violation"
        },
        "code_snippet": {
          "type": "string",
          "description": "The problematic code"
        },
        "suggestion": {
          "type": "string",
          "description": "How to fix the violation"
        },
        "guide_reference": {
          "type": "string",
          "description": "Link to documentation"
        },
        "detected_by": {
          "type": "string",
          "enum": ["automated", "manual"],
          "description": "How the violation was found"
        },
        "fixed_in_revision": {
          "type": "boolean",
          "description": "Whether this was fixed in a subsequent revision"
        }
      }
    }
  }
}
